# Cloud Functions brauchen KEINE .env-Datei: alle Geheimnisse liegen im
# Google Secret Manager und werden ueber `defineSecret()` gebunden
# (functions/src/lib/secrets.ts, functions/src/index.ts). Diese Datei listet
# nur, was es gibt. Achtung: einen Secret-Namen zusaetzlich in functions/.env
# zu setzen, laesst `firebase deploy` mit einem Namenskonflikt abbrechen.
#
# ─── Secrets (einmalig pro Projekt setzen) ───────────────────────────────────
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set SYNC_MANUAL_SECRET
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set RESEND_DOMAIN
#
# GEMINI_API_KEY=your-gemini-api-key           # Gemini Developer API (nur oeffentliche Ausschreibungstexte)
# SYNC_MANUAL_SECRET=a-long-random-string      # Header x-sync-secret fuer syncJobsManual/benachrichtigeManual
# RESEND_API_KEY=re_your_resend_api_key        # Versand der Treffer-Benachrichtigungen
# RESEND_DOMAIN=mail.example.org               # in Resend verifizierte Absender-Domain
#
# Fuer den Functions-Emulator gehoeren Secrets in functions/.secret.local
# (gleiches KEY=value-Format), nicht hierher.
#
# ─── Lokale Werkzeuge (npm run mcp:dev, npm run skill:bundle, ...) ───────────
# Als Umgebungsvariable der Shell setzen, nicht in diese Datei:
#
# GOOGLE_APPLICATION_CREDENTIALS=./.secrets/your-service-account-key.json
# PORT=8090                                    # Port des lokalen MCP-Servers (npm run mcp:dev)
