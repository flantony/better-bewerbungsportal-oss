# Vorlage fuer die lokale Entwicklung: nach `.env.local` kopieren und die Werte
# deines eigenen Firebase-Projekts eintragen
# (Firebase-Konsole -> Projekteinstellungen -> Deine Apps -> Web-App).
#
# NEXT_PUBLIC_*-Werte landen im Browser-Bundle. Hier gehoert also nur die
# oeffentliche Firebase-Client-Konfiguration hin - NIE ein Geheimnis
# (kein Gemini-/Resend-Key, kein Service-Account).
#
# Im Betrieb auf Firebase App Hosting kommen dieselben Werte aus
# web/apphosting.yaml (Vorlage: web/apphosting.example.yaml).

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Basis-URL fuer absolute Metadaten-URLs (metadataBase, Open Graph).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nur fuer Docker/Selbsthosting: Next.js im standalone-Modus bauen.
BUILD_STANDALONE=false
